{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-operating-system/version-worklist.schema.json",
  "title": "Version Worklist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "worklist_id",
    "project",
    "milestone",
    "repository_root",
    "owner_role",
    "updated_at",
    "current_focus_ids",
    "tasks"
  ],
  "properties": {
    "schema_version": { "enum": ["1.0", "1.1"] },
    "worklist_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "project": { "type": "string", "minLength": 1 },
    "milestone": { "type": "string", "minLength": 1 },
    "repository_root": { "type": "string", "minLength": 1 },
    "owner_role": { "const": "chief_of_staff" },
    "updated_at": { "type": "string", "format": "date-time" },
    "authority_note": { "type": "string", "minLength": 1 },
    "current_focus_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/taskId" }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "artifact", "required_capabilities", "required_software", "required_privileges", "human_actions", "environments", "preflight_checks", "fallback_routes", "unresolved"],
      "properties": {
        "status": { "enum": ["draft", "ready", "waived"] },
        "artifact": { "type": "string", "minLength": 1 },
        "required_capabilities": { "$ref": "#/$defs/nonEmptyStrings" },
        "required_software": { "$ref": "#/$defs/nonEmptyStrings" },
        "required_privileges": { "$ref": "#/$defs/nonEmptyStrings" },
        "human_actions": { "$ref": "#/$defs/nonEmptyStrings" },
        "environments": { "$ref": "#/$defs/nonEmptyStrings" },
        "preflight_checks": { "$ref": "#/$defs/nonEmptyStrings" },
        "fallback_routes": { "$ref": "#/$defs/nonEmptyStrings" },
        "unresolved": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "authorization_envelopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision_id", "artifact", "covered_task_ids", "activation_rule", "max_retries"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "decision_id": { "type": "string", "minLength": 1 },
          "artifact": { "type": "string", "minLength": 1 },
          "covered_task_ids": { "$ref": "#/$defs/nonEmptyStrings" },
          "activation_rule": { "type": "string", "minLength": 1 },
          "max_retries": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "taskId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[A-Z][A-Z0-9]*-[0-9]{2}$" },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "actor_role", "from_status", "to_status", "reason", "artifact"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "actor_role": { "type": "string", "minLength": 1 },
        "from_status": { "type": ["string", "null"] },
        "to_status": { "$ref": "#/$defs/status" },
        "reason": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 }
      }
    },
    "status": {
      "enum": [
        "proposed",
        "blocked",
        "authorized",
        "in_progress",
        "ready_for_review",
        "returned_for_correction",
        "accepted",
        "superseded",
        "cancelled"
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "workstream",
        "priority",
        "owner_role",
        "reviewer_role",
        "status",
        "authorization",
        "depends_on",
        "blocked_by",
        "concurrency_group",
        "allow_parallel_in_group",
        "inputs",
        "outputs",
        "scope",
        "exclusions",
        "acceptance_criteria",
        "required_evidence",
        "stop_conditions",
        "history"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/taskId" },
        "title": { "type": "string", "minLength": 1 },
        "workstream": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "owner_role": { "type": "string", "minLength": 1 },
        "reviewer_role": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "decision_id", "artifact"],
          "properties": {
            "state": { "enum": ["not_required", "pending", "approved", "withdrawn"] },
            "decision_id": { "type": ["string", "null"] },
            "artifact": { "type": ["string", "null"] }
          }
        },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/taskId" } },
        "blocked_by": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "concurrency_group": { "type": "string", "minLength": 1 },
        "allow_parallel_in_group": { "type": "boolean" },
        "supersedes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/taskId" } },
        "repository_state": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branch": { "type": ["string", "null"] },
            "executable_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
            "tree": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
            "evidence_head": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "inputs": { "$ref": "#/$defs/nonEmptyStrings" },
        "outputs": { "$ref": "#/$defs/nonEmptyStrings" },
        "scope": { "$ref": "#/$defs/nonEmptyStrings" },
        "exclusions": { "$ref": "#/$defs/nonEmptyStrings" },
        "acceptance_criteria": { "$ref": "#/$defs/nonEmptyStrings" },
        "required_evidence": { "$ref": "#/$defs/nonEmptyStrings" },
        "stop_conditions": { "$ref": "#/$defs/nonEmptyStrings" },
        "history": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/history" } }
        ,
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wave_id", "kind", "environment", "required_capabilities", "required_software", "required_privileges", "human_actions", "preflight_checks", "activation_condition", "pass_route", "fail_route", "retry_policy", "estimated_duration"],
          "properties": {
            "wave_id": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["discovery", "execution", "review", "decision", "closeout"] },
            "environment": { "type": "string", "minLength": 1 },
            "required_capabilities": { "$ref": "#/$defs/nonEmptyStrings" },
            "required_software": { "$ref": "#/$defs/nonEmptyStrings" },
            "required_privileges": { "$ref": "#/$defs/nonEmptyStrings" },
            "human_actions": { "$ref": "#/$defs/nonEmptyStrings" },
            "preflight_checks": { "$ref": "#/$defs/nonEmptyStrings" },
            "activation_condition": { "type": "string", "minLength": 1 },
            "pass_route": { "type": "string", "minLength": 1 },
            "fail_route": { "type": "string", "minLength": 1 },
            "retry_policy": { "type": "string", "minLength": 1 },
            "estimated_duration": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
